{
    "name": "KodeWeb Explorer",
    "short_name": "KW Explorer",
    "description": "Gerenciador de Arquivos Web e Hospedagem na nuvem da família KodeWeb",
    "start_url": "./index.php",
    "display": "standalone",
    "orientation": "any",
    "background_color": "#0b0114",
    "theme_color": "#140523",
    "icons": [
        {
            "src": "logo.svg",
            "type": "image/svg+xml",
            "sizes": "any",
            "purpose": "any maskable"
        }
    ],
    "share_target": {
        "action": "./share_target.php",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [
                {
                    "name": "shared_files[]",
                    "accept": [
                        "*/*"
                    ]
                }
            ]
        }
    }
}